{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kadekutama/go-template/config.schema.json",
  "title": "go-template service configuration (E01-T03)",
  "description": "Mirrors internal/infrastructure/config.Config koanf paths. The alignment test proves every koanf leaf exists here.",
  "type": "object",
  "required": [
    "app",
    "server",
    "database",
    "cache",
    "auth",
    "http_client",
    "nats",
    "redpanda",
    "webhook",
    "coordination",
    "tenancy"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "env"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "string",
          "enum": [
            "local",
            "staging",
            "production"
          ]
        }
      }
    },
    "server": {
      "type": "object",
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "host",
        "port",
        "user",
        "password",
        "name",
        "sslmode"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sslmode": {
          "type": "string",
          "enum": [
            "disable",
            "require",
            "verify-full"
          ]
        },
        "max_open_conns": {
          "type": "integer",
          "minimum": 1
        },
        "max_idle_conns": {
          "type": "integer",
          "minimum": 0
        },
        "conn_max_lifetime_sec": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cache": {
      "type": "object",
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "l1_maximum_size": {
          "type": "integer",
          "minimum": 1
        },
        "ttls": {
          "type": "object",
          "properties": {
            "balance_sec": {
              "type": "integer",
              "minimum": 1
            },
            "balance_cursor_sec": {
              "type": "integer",
              "minimum": 1
            },
            "config_sec": {
              "type": "integer",
              "minimum": 1
            },
            "config_long_sec": {
              "type": "integer",
              "minimum": 1
            },
            "fx_sec": {
              "type": "integer",
              "minimum": 1
            },
            "idempotency_hint_sec": {
              "type": "integer",
              "minimum": 1
            },
            "rate_limit_sec": {
              "type": "integer",
              "minimum": 1
            },
            "l1_populate_sec": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "issuer",
        "access_ttl_min",
        "refresh_ttl_days",
        "api_key"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "access_ttl_min": {
          "type": "integer",
          "minimum": 1
        },
        "refresh_ttl_days": {
          "type": "integer",
          "minimum": 1
        },
        "api_key": {
          "type": "object",
          "required": [
            "time",
            "memory_kib",
            "threads",
            "key_len",
            "salt_len"
          ],
          "properties": {
            "time": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "memory_kib": {
              "type": "integer",
              "minimum": 8192
            },
            "threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "key_len": {
              "type": "integer",
              "minimum": 16,
              "maximum": 64
            },
            "salt_len": {
              "type": "integer",
              "minimum": 8,
              "maximum": 64
            }
          }
        }
      }
    },
    "nats": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "log_level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "log_output": {
          "type": "string",
          "enum": [
            "stdout",
            "file",
            "both"
          ]
        },
        "log_file": {
          "type": "string"
        },
        "log_max_size_mb": {
          "type": "integer",
          "minimum": 1
        },
        "log_max_backups": {
          "type": "integer",
          "minimum": 0
        },
        "log_max_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "log_compress": {
          "type": "boolean"
        },
        "otlp_endpoint": {
          "type": "string"
        },
        "sample_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "excluded_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profiling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "server_address": {
              "type": "string"
            },
            "application_name": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "upload_rate": {
              "type": "string"
            },
            "mutex_profile_fraction": {
              "type": "integer",
              "minimum": 0
            },
            "block_profile_rate": {
              "type": "integer",
              "minimum": 0
            },
            "disable_gc_runs": {
              "type": "boolean"
            },
            "tags": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "feature_flags": {
      "type": "object",
      "properties": {
        "unleash_url": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openbao",
            "bitwarden",
            "env",
            ""
          ]
        }
      }
    },
    "coordination": {
      "type": "object",
      "properties": {
        "etcd_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "etcd_dial_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "etcd_election_ttl_sec": {
          "type": "integer",
          "minimum": 1
        },
        "leader_key_prefix": {
          "type": "string"
        }
      }
    },
    "tenancy": {
      "type": "object",
      "required": [
        "max_onboarding_assets"
      ],
      "properties": {
        "max_onboarding_assets": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cron_admin": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bind_addr": {
          "type": "string"
        },
        "private_listener": {
          "type": "boolean"
        },
        "allowed_origin": {
          "type": "string"
        },
        "tls_cert_file": {
          "type": "string"
        },
        "tls_key_file": {
          "type": "string"
        },
        "tls_client_ca_file": {
          "type": "string"
        },
        "rate_limit_budget": {
          "type": "integer"
        },
        "rate_limit_window_sec": {
          "type": "integer"
        },
        "session_max_ttl_sec": {
          "type": "integer"
        },
        "session_scope": {
          "type": "string"
        },
        "session_cookie_name": {
          "type": "string"
        },
        "limiter_namespace": {
          "type": "string"
        },
        "anonymous_subject": {
          "type": "string"
        },
        "session_key_file": {
          "type": "string"
        }
      }
    },
    "redpanda": {
      "type": "object",
      "required": [
        "brokers",
        "topic_ledger_events",
        "topic_outbox_facts",
        "topic_webhook_jobs",
        "topic_audit_streams",
        "partitions",
        "retention_hours",
        "partition_keys",
        "dlq_suffix"
      ],
      "properties": {
        "brokers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topic_ledger_events": {
          "type": "string",
          "minLength": 1
        },
        "topic_outbox_facts": {
          "type": "string",
          "minLength": 1
        },
        "topic_webhook_jobs": {
          "type": "string",
          "minLength": 1
        },
        "topic_audit_streams": {
          "type": "string",
          "minLength": 1
        },
        "partitions": {
          "type": "integer",
          "minimum": 1
        },
        "retention_hours": {
          "type": "integer",
          "minimum": 1
        },
        "partition_keys": {
          "type": "string",
          "minLength": 1
        },
        "dlq_suffix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "webhook": {
      "type": "object",
      "required": [
        "retry_steps_sec",
        "tolerance_sec"
      ],
      "properties": {
        "retry_steps_sec": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "tolerance_sec": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "http_client": {
      "type": "object",
      "required": [
        "timeout_sec",
        "max_idle_conns",
        "max_idle_conns_per_host",
        "idle_conn_timeout_sec"
      ],
      "properties": {
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "max_idle_conns": {
          "type": "integer",
          "minimum": 1
        },
        "max_idle_conns_per_host": {
          "type": "integer",
          "minimum": 1
        },
        "idle_conn_timeout_sec": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

# Production process environment template (E01-T03).
# Copy to `.env.production` (gitignored via `.env.*`) or inject into Kubernetes Secrets/ConfigMaps.
# Secrets MUST be injected at deployment time via OpenBao (E09) or CI/CD environment secrets.

# --- fx lifecycle ---
APP_FX_START_TIMEOUT=60s
APP_FX_STOP_TIMEOUT=60s

# --- etcd coordination plane ---
APP_COORDINATION__ETCD_ENDPOINTS=http://etcd.production.svc:2379
APP_COORDINATION__ETCD_DIAL_TIMEOUT_SEC=5
APP_COORDINATION__ETCD_ELECTION_TTL_SEC=5
APP_COORDINATION__ETCD_LEADER_PREFIX=/finance/worker-leader

# --- database DSN ---
DATABASE_URL=postgres://app_production:{{ secret:db/production/password }}@postgres.production.svc:5432/app?sslmode=verify-full

# --- object storage ---
OBJECT_STORAGE_URL=s3://ledger-backups-production?endpoint=https://s3.amazonaws.com

# --- observability ---
APP_OBSERVABILITY__LOG_LEVEL=warn
APP_OBSERVABILITY__OTLP_ENDPOINT=https://tempo.production.svc:4317

# --- migration tooling ---
ATLAS_DEV_URL=

# --- release version ---
VERSION=

# --- test harness ---
TESTCONTAINERS_SKIP=1
TESTCONTAINERS_PROFILE=ci

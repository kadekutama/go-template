# Process environment contract (E01-T03-R09). Copy to `.env` (gitignored) and
# `set -a; source .env` to apply locally, or export selectively. Every
# `os.Getenv` site in non-test Go code is listed here with its default and
# shape; unset keys always fall back safely. Structured config lives in
# config/*.yaml (see config/schemas/config.json); APP_<SECTION>__<KEY> names
# below mirror koanf paths, so file and env stay one contract.

# --- fx lifecycle (internal/shared/di; all binaries) ---
# Bounds for fx OnStart hooks (pool opens) and OnStop drain. Go durations.
# Unset keeps 30s; malformed values fail fast at boot.
APP_FX_START_TIMEOUT=30s
APP_FX_STOP_TIMEOUT=30s

# --- etcd coordination plane (internal/infrastructure/coordination/etcd) ---
# Comma-separated client URLs. Unset keeps http://127.0.0.1:2379.
APP_COORDINATION__ETCD_ENDPOINTS=http://127.0.0.1:2379
# Dial timeout seconds for initial connection. Positive integer; unset keeps 5.
APP_COORDINATION__ETCD_DIAL_TIMEOUT_SEC=5
# Leader-election lease TTL seconds. Positive integer; unset keeps 5.
APP_COORDINATION__ETCD_ELECTION_TTL_SEC=5
# Election key prefix override. Blank keeps /finance/worker-leader.
APP_COORDINATION__ETCD_LEADER_PREFIX=

# --- database DSN (cmd/seed, scripts/db/*, integration suites) ---
# Postgres DSN; required wherever used (each consumer fails loudly if absent).
# Defaults to local config.yaml (postgres:postgres on app DB).
# For Patroni HA compose, use: postgres://postgres:postgres_pw@127.0.0.1:5432/postgres?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app?sslmode=disable

# --- object storage (scripts/db/backup.sh) ---
# S3/MinIO endpoint for ledger backup uploads; unset writes to local directory only.
OBJECT_STORAGE_URL=

# --- observability (internal/infrastructure/logging, tracing) ---
# Log level: debug, info, warn, error. Unset keeps info.
APP_OBSERVABILITY__LOG_LEVEL=info
# OTLP collector endpoint (e.g. http://127.0.0.1:4317). Unset disables export.
APP_OBSERVABILITY__OTLP_ENDPOINT=

# --- migration tooling (scripts/db/migrate.sh lint) ---
# Dev-database URL for Atlas safety linting. Unset uses a dockerized PostgreSQL.
ATLAS_DEV_URL=

# --- release version override (scripts/build/version.sh, CI) ---
# Explicit version stamp; unset derives from git (tags/count/SHA) or "dev".
VERSION=

# --- test harness (test/testcontainers) ---
# Set to 1 to skip container suites when no Docker daemon is reachable.
TESTCONTAINERS_SKIP=
# Container profile: local (default) or ci (reduced resources).
TESTCONTAINERS_PROFILE=local


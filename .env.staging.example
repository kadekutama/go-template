# Staging process environment template (E01-T03).
# Copy to `.env.staging` (gitignored via `.env.*`) or inject into Kubernetes Secrets/ConfigMaps.
# Secrets MUST be injected at deployment time via OpenBao (E09) or CI/CD environment secrets.

# --- fx lifecycle ---
APP_FX_START_TIMEOUT=45s
APP_FX_STOP_TIMEOUT=45s

# --- etcd coordination plane ---
APP_COORDINATION__ETCD_ENDPOINTS=http://etcd.staging.svc:2379
APP_COORDINATION__ETCD_DIAL_TIMEOUT_SEC=5
APP_COORDINATION__ETCD_ELECTION_TTL_SEC=5
APP_COORDINATION__ETCD_LEADER_PREFIX=/finance/worker-leader

# --- database DSN ---
DATABASE_URL=postgres://app_staging:{{ secret:db/staging/password }}@postgres.staging.svc:5432/app?sslmode=require

# --- object storage ---
OBJECT_STORAGE_URL=s3://ledger-backups-staging?endpoint=https://minio.staging.svc:9000

# --- observability ---
APP_OBSERVABILITY__LOG_LEVEL=info
APP_OBSERVABILITY__OTLP_ENDPOINT=https://tempo.staging.svc:4317

# --- migration tooling ---
ATLAS_DEV_URL=

# --- release version ---
VERSION=

# --- test harness ---
TESTCONTAINERS_SKIP=1
TESTCONTAINERS_PROFILE=ci
